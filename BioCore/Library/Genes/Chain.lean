/-- The whole chain for BRCA1 in one statement. -/
theorem BRCA1.chain :
    decodeCDS standardCode (transcribe BRCA1.codingStrand) = .ok BRCA1.protein
      ∧ Balanced (transcriptionRxn (transcribe BRCA1.codingStrand))
      ∧ Balanced (peptideRxn BRCA1.protein) := by
  rw [BRCA1.transcription]
  exact ⟨BRCA1.decoding, BRCA1.rna_balanced, BRCA1.protein_balanced⟩

