theorem INS.transcription : transcribe INS.codingStrand = INS.rna := by decide +kernel
theorem INS.decoding : decodeCDS standardCode INS.rna = .ok INS.protein := by decide +kernel
theorem INS.rna_balanced : Balanced (transcriptionRxn INS.rna) := BioCore.transcription_balanced INS.rna
theorem INS.protein_balanced : Balanced (peptideRxn INS.protein) := BioCore.peptide_balanced INS.protein

/-- The whole chain for INS in one statement. -/
theorem INS.chain :
    decodeCDS standardCode (transcribe INS.codingStrand) = .ok INS.protein
      ∧ Balanced (transcriptionRxn (transcribe INS.codingStrand))
      ∧ Balanced (peptideRxn INS.protein) := by
  rw [INS.transcription]
  exact ⟨INS.decoding, INS.rna_balanced, INS.protein_balanced⟩

